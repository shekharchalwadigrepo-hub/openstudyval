\name{openstudyval-package}
\alias{openstudyval}
\alias{openstudyval-package}
\title{Open validator for FDA study-data submissions}
\description{
Validates a study folder against publicly described FDA technical-rejection
criteria, SAS XPORT constraints, and an extensible SDTM, SEND, and ADaM
structural catalog. Independent of Pinnacle 21 and not an FDA certification.
}
